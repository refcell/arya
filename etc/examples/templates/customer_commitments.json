{
  "adapter" : "default",
  "autonomy" : "suggest",
  "bindings" : [
    {
      "actions" : [
        "create",
        "update",
        "remind"
      ],
      "args" : [

      ],
      "command" : "tracker-mcp",
      "id" : "tracker",
      "kind" : "mcp",
      "read" : [
        "search",
        "get"
      ]
    }
  ],
  "crew" : {
    "maxParallel" : 1
  },
  "department" : "Account management",
  "effort" : "medium",
  "gate" : {
    "samples" : 1,
    "tolerance" : 0
  },
  "guardrails" : [
    "Never change a due date without the owner.",
    "Remind the owner before telling the customer anything."
  ],
  "id" : "st_customer_commitments",
  "limits" : {
    "maxCostMicros" : 2000000,
    "maxTurns" : 40,
    "timeoutSeconds" : 900
  },
  "metric" : {
    "direction" : "up",
    "name" : "commitments_met_on_time",
    "target" : 0.95,
    "unit" : "ratio"
  },
  "name" : "Customer commitments",
  "outcome" : "Every commitment made to a customer is tracked and met by its due date.",
  "policy" : {
    "default" : "ask",
    "rules" : [
      {
        "action" : "create",
        "decision" : "auto",
        "note" : "Tracking a commitment changes nothing for the customer."
      },
      {
        "action" : "remind",
        "decision" : "auto",
        "note" : "Reminders go to the internal owner."
      },
      {
        "action" : "update",
        "decision" : "ask",
        "note" : "Changing a commitment needs its owner."
      }
    ]
  },
  "scorer" : {
    "fields" : [
      "decisions.choice"
    ],
    "kind" : "exact"
  },
  "triggers" : [
    {
      "everySeconds" : 3600,
      "kind" : "interval"
    },
    {
      "kind" : "manual"
    }
  ],
  "v" : 1
}
