{
  "v": 1,
  "profiles": {
    "claude-code": {
      "kind": "exec",
      "command": "claude",
      "args": {
        "low": ["-p", "--output-format", "stream-json", "--verbose", "--model", "haiku",
          "--mcp-config", "{mcpConfig}", "--disallowedTools",
          "Bash Edit Write NotebookEdit WebFetch WebSearch"],
        "medium": ["-p", "--output-format", "stream-json", "--verbose", "--model", "sonnet",
          "--mcp-config", "{mcpConfig}", "--disallowedTools",
          "Bash Edit Write NotebookEdit WebFetch WebSearch"],
        "high": ["-p", "--output-format", "stream-json", "--verbose", "--model", "opus",
          "--mcp-config", "{mcpConfig}", "--disallowedTools",
          "Bash Edit Write NotebookEdit WebFetch WebSearch"]
      },
      "promptVia": "stdin",
      "parse": "stream-json",
      "mcpConfig": "file",
      "sandbox": "workdir"
    },
    "codex-cli": {
      "kind": "exec",
      "command": "codex",
      "args": {
        "low": ["exec", "--sandbox", "read-only", "--skip-git-repo-check", "-c",
          "model_reasoning_effort=low", "-"],
        "medium": ["exec", "--sandbox", "read-only", "--skip-git-repo-check", "-c",
          "model_reasoning_effort=medium", "-"],
        "high": ["exec", "--sandbox", "read-only", "--skip-git-repo-check", "-c",
          "model_reasoning_effort=high", "-"]
      },
      "promptVia": "stdin",
      "parse": "text",
      "mcpConfig": "none",
      "sandbox": "workdir"
    }
  }
}
