{
  "v": 1,
  "id": "st_triage",
  "name": "Support inbox triage",
  "outcome": "Every new message in the support inbox is labeled and routed to the right queue within one hour.",
  "metric": {
    "name": "routed_within_1h",
    "unit": "ratio",
    "direction": "up",
    "target": 0.95
  },
  "guardrails": [
    "Never delete a message.",
    "Ask before replying to a customer.",
    "Route anything about security to the security queue."
  ],
  "bindings": [
    {
      "id": "inbox",
      "kind": "mcp",
      "command": "inbox-mcp",
      "args": [],
      "read": [
        "search",
        "get"
      ],
      "actions": [
        "label",
        "route",
        "reply"
      ]
    },
    {
      "id": "billing",
      "kind": "mcp",
      "command": "billing-mcp",
      "args": [],
      "read": [
        "order"
      ],
      "actions": [
        "refund"
      ]
    },
    {
      "id": "person:sam",
      "kind": "person",
      "channel": "inbox",
      "name": "Sam",
      "role": "support lead"
    }
  ],
  "triggers": [
    {
      "kind": "interval",
      "everySeconds": 900
    },
    {
      "kind": "manual"
    }
  ],
  "policy": {
    "default": "ask",
    "approvers": [
      {
        "action": "reply",
        "people": ["local", "person:sam"],
        "note": "Sam or you sign off customer replies."
      }
    ],
    "rules": [
      {
        "action": "label",
        "decision": "auto",
        "note": "Labels are safe to change, so the steward applies them on its own."
      },
      {
        "action": "route",
        "decision": "auto",
        "note": "Routing only moves a message between queues, so it runs on its own."
      },
      {
        "action": "reply",
        "decision": "ask",
        "note": "Replies to customers need your sign-off, since a sent reply cannot be recalled."
      },
      {
        "action": "refund",
        "decision": "ask",
        "note": "Refunds move money, so a person approves each one."
      },
      {
        "action": "delete",
        "decision": "deny",
        "note": "The steward never deletes messages; people decide what to throw away."
      }
    ]
  },
  "adapter": "fake-triage",
  "effort": "medium",
  "crew": {
    "maxParallel": 1
  },
  "limits": {
    "maxTurns": 10,
    "timeoutSeconds": 60,
    "maxCostMicros": 0
  },
  "scorer": {
    "kind": "exact",
    "fields": [
      "decisions.choice",
      "actions.kind",
      "actions.target"
    ]
  },
  "gate": {
    "samples": 1,
    "tolerance": 0.0
  }
}
